{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "banking-platform-front",
  "compatibility_date": "2026-11-04",
  // Worker que sirve la SPA y hace de proxy de /api/* hacia FastAPI (mismo origen para la cookie __Host-session)
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Solo /api/* pasa por el Worker; el resto lo sirve directamente el runtime de assets
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Origen del backend, sin "/" final. No es un secreto: el navegador nunca lo ve ni lo usa.
    "BACKEND_URL": "https://backend-bcgxcrfbg7dpdebp.mexicocentral-01.azurewebsites.net"
  },
  "previews": {
    "vars": {
      "BACKEND_URL": "https://backend-dev-fcd8and9b0afeuf5.mexicocentral-01.azurewebsites.net"
    }
  }
}
